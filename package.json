{
  "name": "claimfighter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@emailjs/browser": "^4.3.3",
    "@anthropic-ai/sdk": "^0.27.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "playwright-core": "^1.64.1",
    "vite": "^5.0.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:content": "node scripts/generate-content.js",
    "generate:pages": "node scripts/build-pages.js",
    "generate:citations": "node scripts/build-verified-citations.mjs",
    "test:citelint": "node scripts/test-citelint.mjs",
    "test:authgate": "node scripts/test-authgate.mjs",
    "test": "node --test tests/payhip-mock.test.js tests/isCheckCall.test.js tests/lock-extended.test.js tests/verified-on.test.js tests/checklist-maxtokens.test.js",
    "check:verified-on": "node scripts/check-verified-on.mjs",
    "stamp:verified-on": "node scripts/stamp-verified-on.mjs",
    "test:ui": "node --test tests/ui-wiring.test.mjs",
    "generate:all": "npm run generate:content && npm run generate:pages"
  }
